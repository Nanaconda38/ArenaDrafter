<Window x:Class="ArenaDrafter.BugReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Report a bug" Width="680" Height="720" MinWidth="560" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" Background="#0A0F14"
        Foreground="#F0EBDD" FontFamily="Segoe UI Variable Text" FontSize="14">
    <Window.Resources>
        <SolidColorBrush x:Key="Surface" Color="#101A24"/>
        <SolidColorBrush x:Key="Line" Color="#263848"/>
        <SolidColorBrush x:Key="Muted" Color="#9DB3C5"/>
        <SolidColorBrush x:Key="Gold" Color="#D2A84D"/>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0D151D"/><Setter Property="Foreground" Value="#F0EBDD"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="9,7"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#0D151D"/><Setter Property="Foreground" Value="#F0EBDD"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#172536"/><Setter Property="Foreground" Value="#F0EBDD"/>
            <Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="14,8"/>
        </Style>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock FontFamily="Bahnschrift SemiCondensed" FontSize="25" FontWeight="SemiBold" Text="REPORT A BUG"/>
            <TextBlock Margin="0,4,0,18" Foreground="{StaticResource Muted}" Text="Create a sanitized diagnostic ZIP with the app, probe, and relevant trace logs."/>
        </StackPanel>
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0"><TextBlock Margin="0,0,0,5" Text="Area"/><ComboBox x:Name="AreaBox"/></StackPanel>
            <StackPanel Grid.Column="1"><TextBlock Margin="0,0,0,5" Text="Short summary"/><TextBox x:Name="SummaryBox" MaxLength="160"/></StackPanel>
        </Grid>
        <TextBlock Grid.Row="2" Margin="0,0,0,5" Text="What happened?"/>
        <TextBox x:Name="ActualBox" Grid.Row="3" Height="110" Margin="0,0,0,12" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
        <StackPanel Grid.Row="4" Margin="0,0,0,12"><TextBlock Margin="0,0,0,5" Text="What did you expect?"/><TextBox x:Name="ExpectedBox" Height="82" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
        <StackPanel Grid.Row="5" Margin="0,0,0,12"><TextBlock Margin="0,0,0,5" Text="Steps to reproduce"/><TextBox x:Name="StepsBox" Height="82" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></StackPanel>
        <CheckBox x:Name="IncludeConfigurationBox" Grid.Row="6" Margin="0,0,0,10" Content="Include my Live Arena strategy and Battle Opener configuration"/>
        <Border Grid.Row="7" Padding="12" Margin="0,0,0,16" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="5">
            <TextBlock Foreground="{StaticResource Muted}" TextWrapping="Wrap" Text="Paths, Windows user details, machine name, SIDs, account identifiers, tokens, and credentials are removed. No file is uploaded automatically. Review the ZIP and only share it through a trusted channel."/>
        </Border>
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Margin="0,0,8,0" Content="Cancel" IsCancel="True"/>
            <Button Background="{StaticResource Gold}" Foreground="#0A0F14" BorderBrush="{StaticResource Gold}" FontWeight="SemiBold" Content="Create diagnostic ZIP" Click="Create_Click" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
