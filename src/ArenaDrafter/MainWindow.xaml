                        <Border Grid.Column="2" Background="#172129" BorderBrush="#273842" BorderThickness="1" CornerRadius="8" Padding="12" Margin="8,0,0,0">
                            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                <TextBlock FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="SemiBold" Text="OPENING SEQUENCE"/>
                                <TextBlock Grid.Row="1" Margin="0,3,0,8" Foreground="#96A6AA" FontSize="11" Text="RAID plays from top to bottom. Choose a target rule only when a skill needs one."/>
                                <ListBox x:Name="ArenaOpenerSequenceList" Grid.Row="2" MinHeight="260" Background="#0A0F14" BorderBrush="#273842" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="5,3"/></Style></ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate><DataTemplate>
                                        <Border Background="#172129" BorderBrush="#4FB3A8" BorderThickness="3,1,1,1" CornerRadius="7" Padding="8">
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="185"/><ColumnDefinition Width="165"/></Grid.ColumnDefinitions>
                                                <TextBlock VerticalAlignment="Center" Foreground="#96A6AA" FontSize="16" Text="â‹®â‹®" ToolTip="Use Move up / Move down to change the order"/>
                                                <Grid Grid.Column="1" Width="42" Height="42"><Ellipse Fill="#1D2B34" Stroke="#4FB3A8" StrokeThickness="1"/><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#4FB3A8" FontWeight="Bold" Text="{Binding Label}"/><Ellipse><Ellipse.Fill><ImageBrush ImageSource="{Binding Icon}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse></Grid>
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="7,0"><TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Margin="0,3,0,0"><TextBlock Foreground="#4FB3A8" FontSize="10" Text="{Binding FormLabel}"/><TextBlock Foreground="#637078" FontSize="10" Text="  â€¢  "/><TextBlock Foreground="#96A6AA" FontSize="10" Text="{Binding TargetLabel}"/><TextBlock Foreground="#637078" FontSize="10" Text="  â€¢  "/><TextBlock Foreground="#96A6AA" FontSize="10" Text="{Binding CooldownLabel}"/></StackPanel></StackPanel>
                                                <ComboBox Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding TargetOptions}" SelectedItem="{Binding TargetPolicy, Mode=TwoWay}" SelectionChanged="ArenaOpenerTarget_SelectionChanged" ToolTip="Who RAID should target with this skill">
                                                    <ComboBox.Style>
                                                        <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding RequiresTarget}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </ComboBox.Style>
                                                </ComboBox>
                                                <ComboBox Grid.Column="4" Margin="8,0,0,0" VerticalAlignment="Center" ItemsSource="{Binding AllyTargets}" DisplayMemberPath="Name" SelectedValuePath="BaseId" SelectedValue="{Binding TargetBaseId, Mode=TwoWay}" SelectionChanged="ArenaOpenerSpecificAlly_SelectionChanged" ToolTip="Preferred allied champion"><ComboBox.Style><Style TargetType="ComboBox"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding UsesSpecificAlly}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></ComboBox.Style></ComboBox>
                                            </Grid>
                                        </Border>
                                    </DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                                <Border Grid.Row="2" Background="#0A0F14" IsHitTestVisible="False">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasItems, ElementName=ArenaOpenerSequenceList}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="280">
                                        <TextBlock HorizontalAlignment="Center" FontWeight="SemiBold" Text="No opening steps yet"/>
                                        <TextBlock Margin="0,5,0,0" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#96A6AA" FontSize="11" Text="Select a skill on the left to create the order RAID will play." TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                                <DockPanel Grid.Row="3" Margin="0,9,0,0"><Button DockPanel.Dock="Right" Content="Clear sequence" Click="ClearArenaOpener_Click"/><StackPanel Orientation="Horizontal"><Button Content="Move up" Tag="up" Click="MoveArenaOpenerSkill_Click" Margin="0,0,7,0"/><Button Content="Move down" Tag="down" Click="MoveArenaOpenerSkill_Click"/></StackPanel></DockPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <Border Grid.Row="3" Margin="0,12,0,0" Background="#172129" BorderBrush="#4FB3A8" BorderThickness="1" CornerRadius="6" Padding="11"><TextBlock x:Name="ArenaOpenerStatusText" Foreground="#4FB3A8" TextWrapping="Wrap" Text="No opening sequence: RAID Auto starts immediately when the battle HUD appears."/></Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="DraftLabTab" Header="Draft Lab">
                <Grid Margin="18,16" TextElement.Foreground="{StaticResource TextBrush}">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <DockPanel Margin="2,0,0,12">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#172129" BorderBrush="#4FB3A8" BorderThickness="1" CornerRadius="14" Padding="11,6"><TextBlock Foreground="#4FB3A8" FontSize="10" FontWeight="Bold" Text="SIMULATION ONLY"/></Border>
                            <Button Margin="10,0,0,0" Style="{StaticResource PrimaryButton}" Content="Start simulation" Click="StartDraftSimulation_Click"/>
                        </StackPanel>
                        <StackPanel><TextBlock FontFamily="Bahnschrift SemiCondensed" FontSize="22" FontWeight="SemiBold" Text="DRAFT SIMULATOR"/><TextBlock Margin="0,3,0,0" Foreground="#96A6AA" Text="Rehearse picks, bans, and leader decisions. No match starts and no commands are sent to RAID."/></StackPanel>
                    </DockPanel>
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="240"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,8,0"><TextBlock Margin="2,0,0,4" Foreground="#96A6AA" FontSize="11" Text="First pick"/><ComboBox x:Name="SimulatorFirstBox"/></StackPanel>
                        <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Margin="2,0,0,4" Foreground="#96A6AA" FontSize="11" Text="Draft rule"/><ComboBox x:Name="SimulatorRuleBox"/></StackPanel>
                        <Border Grid.Column="2" Background="#172129" BorderBrush="#4FB3A8" BorderThickness="1" CornerRadius="5" Padding="11"><TextBlock VerticalAlignment="Center" Foreground="#4FB3A8" Text="Simulation is local only. Configure the rules, then start when ready." TextWrapping="Wrap"/></Border>
                    </Grid>
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions><RowDefinition Height="145"/><RowDefinition Height="*"/><RowDefinition Height="145"/></Grid.RowDefinitions>
                         <Border Grid.Row="2" Background="#172129" BorderBrush="#273842" BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,8,0,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="SemiBold" Text="BOT PICKS"/><TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="#4FB3A8" FontSize="10" FontWeight="Bold" Text="SIMULATED TEAM"/></DockPanel><ListBox x:Name="SimulatorPlayerList" Grid.Row="1" Margin="0,8,0,0" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,10,0"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Width="170" Background="#172129" BorderBrush="#273842" BorderThickness="1" CornerRadius="6" Padding="8"><StackPanel Orientation="Horizontal"><Border Width="52" Height="52" Margin="0,0,9,0" Background="#0A0F14" CornerRadius="4" ClipToBounds="True"><local:PortraitImage Width="52" Height="52" Source="{Binding Portrait}" PlaceholderText="{Binding Name}" Stretch="UniformToFill"/></Border><StackPanel VerticalAlignment="Center"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Margin="0,4,0,0" Foreground="#96A6AA" FontSize="10" Text="BOT PICK"/></StackPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
                         <Border Grid.Row="1" Background="#0A0F14" BorderBrush="#273842" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><DockPanel><TextBlock FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="SemiBold" Text="DECISION HISTORY"/><TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="#96A6AA" FontSize="10" FontWeight="Bold" Text="CONTEXTUAL ACTION"/></DockPanel><Grid Grid.Row="1" Margin="0,8,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#172129" BorderBrush="#4FB3A8" BorderThickness="1" CornerRadius="5" Padding="10,7" Margin="0,0,8,0"><TextBlock x:Name="SimulatorStatusText" Foreground="#4FB3A8" Text="Configure the simulation, then start." TextWrapping="Wrap"/></Border><Button x:Name="SimulatorRunBotButton" Grid.Column="1" MinWidth="150" Style="{StaticResource PrimaryButton}" Content="Run bot turn" Click="RunSimulatorBotTurn_Click" IsEnabled="False"/></Grid><Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,7,0"><TextBlock Margin="0,0,0,3" Foreground="#96A6AA" FontSize="10" Text="OPPONENT PICK"/><TextBox x:Name="SimulatorOpponentSearchBox" Padding="8,6" TextChanged="SimulatorOpponentSearch_TextChanged" ToolTip="Filter opponent champions"/></StackPanel><ComboBox x:Name="SimulatorOpponentCandidateBox" Grid.Column="1" Margin="0,15,7,0" MaxDropDownHeight="280"><ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="30" Height="30" Margin="0,0,8,0" Background="#0A0F14" CornerRadius="3"><local:PortraitImage Width="30" Height="30" Source="{Binding Portrait}" PlaceholderText="{Binding Name}" Stretch="UniformToFill"/></Border><TextBlock VerticalAlignment="Center" Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button x:Name="SimulatorAddOpponentButton" Grid.Column="2" Margin="0,15,0,0" Content="Add opponent pick" Click="AddSimulatorOpponentPick_Click" IsEnabled="False"/></Grid><ListBox x:Name="SimulatorEventList" Grid.Row="3" Margin="0,9,0,9" Background="#101820" BorderBrush="#273842"/><Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ComboBox x:Name="SimulatorPlayerBanBox" Margin="0,0,7,0" DisplayMemberPath="Name" ToolTip="Champion banned by the simulated opponent"/><Button x:Name="SimulatorResolveButton" Grid.Column="1" Content="Resolve ban + leader" Click="ResolveDraftSimulation_Click" IsEnabled="False"/></Grid></Grid></Border>
                         <Border Grid.Row="0" Background="#172129" BorderBrush="#273842" BorderThickness="1" CornerRadius="6" Padding="11" Margin="0,0,0,8"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><DockPanel><TextBlock FontFamily="Bahnschrift SemiCondensed" FontSize="16" FontWeight="SemiBold" Text="OPPONENT PICKS"/><TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" Foreground="#4FB3A8" FontSize="10" FontWeight="Bold" Text="DRAFT OPPONENT"/></DockPanel><ListBox x:Name="SimulatorOpponentList" Grid.Row="1" Margin="0,8,0,0" Background="Transparent" BorderThickness="0" AllowDrop="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,10,0"/></Style></ListBox.ItemContainerStyle><ListBox.ItemTemplate><DataTemplate><Border Width="170" Background="#172129" BorderBrush="#273842" BorderThickness="1" CornerRadius="6" Padding="8"><StackPanel Orientation="Horizontal"><Border Width="52" Height="52" Margin="0,0,9,0" Background="#0A0F14" CornerRadius="4" ClipToBounds="True"><local:PortraitImage Width="52" Height="52" Source="{Binding Portrait}" PlaceholderText="{Binding Name}" Stretch="UniformToFill"/></Border><StackPanel VerticalAlignment="Center"><TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Margin="0,4,0,0" Foreground="#96A6AA" FontSize="10" Text="OPPONENT PICK"/></StackPanel></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
                    </Grid>
                </Grid>
            </TabItem>

            </TabControl>
        </Grid>
        <Grid x:Name="DeveloperToolsLayer" Grid.Row="1" Panel.ZIndex="100" Visibility="Collapsed" IsHitTestVisible="False">
            <Button x:Name="DeveloperToolsBackdrop" Style="{x:Null}" Background="#660A0F14" BorderThickness="0" Click="CloseDeveloperTools_Click" IsTabStop="False"/>
            <Border x:Name="DeveloperToolsDrawer" Width="440" HorizontalAlignment="Right" Background="#172129" BorderBrush="#273842" BorderThickness="1,0,0,0" Padding="18" IsHitTestVisible="True">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,16">
                            <Button DockPanel.Dock="Right" Padding="10,5" Content="Close" Click="CloseDeveloperTools_Click"/>
                            <StackPanel>
                                <TextBlock FontFamily="Bahnschrift SemiCondensed" FontSize="20" FontWeight="SemiBold" Text="DEVELOPER TOOLS"/>
                                <TextBlock Margin="0,3,0,0" Foreground="#96A6AA" FontSize="11" Text="Technical visibility without cluttering the workspace."/>
                            </StackPanel>
                        </DockPanel>

                        <Border Background="#172129" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock FontFamily="Bahnschrift SemiCondensed" FontSize="15" FontWeight="SemiBold" Text="CONNECTION AND BUILD"/>
                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <TextBlock Foreground="#96A6AA" Text="Connection state"/>
                                    <TextBlock x:Name="DeveloperConnectionStateText" Grid.Column="1" HorizontalAlignment="Right" Foreground="#4FB3A8" FontWeight="SemiBold" Text="{Binding Text, ElementName=StatusText}"/>
                                    <TextBlock Grid.Row="1" Margin="0,6,0,0" Foreground="#96A6AA" Text="Supported RAID build"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" HorizontalAlignment="Right" Foreground="#F0EBDD" Text="11.71.0"/>
                                    <TextBlock Grid.Row="2" Margin="0,6,0,0" Foreground="#96A6AA" Text="Draft rule"/>
                                    <TextBlock x:Name="DeveloperDraftRuleText" Grid.Row="2" Grid.Column="1" Margin="12,6,0,0" HorizontalAlignment="Right" TextAlignment="Right" Foreground="#4FB3A8" Text="{Binding Text, ElementName=ArenaRulesText}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="3" Margin="0,6,0,0" Foreground="#96A6AA" Text="Catalog"/>
                                    <TextBlock x:Name="DeveloperCatalogStatusText" Grid.Row="3" Grid.Column="1" Margin="12,6,0,0" HorizontalAlignment="Right" Foreground="#F0EBDD" Text="Waiting for RAID catalog" TextWrapping="Wrap"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="#172129" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock FontFamily="Bahnschrift SemiCondensed" FontSize="15" FontWeight="SemiBold" Text="ARENA DIAGNOSTICS"/>
                                <TextBlock Margin="0,3,0,10" Foreground="#96A6AA" FontSize="11" Text="Record passive Live Arena research traces." TextWrapping="Wrap"/>
                                <WrapPanel>
                                    <Button x:Name="RewardDiagnosticButton" Margin="0,0,8,8" Padding="10,6" Content="Record reward trace" Click="ToggleRewardDiagnostics_Click" ToolTip="Passively record visible Live Arena reward UI state while you claim rewards manually"/>
                                    <Button x:Name="ArenaInspectorButton" Margin="0,0,0,8" Padding="10,6" Content="Inspector" Click="ToggleArenaInspector_Click" ToolTip="Open live battle telemetry and the event journal"/>
                                </WrapPanel>
                                <TextBlock Margin="0,2,0,0" Foreground="#4FB3A8" Text="{Binding Text, ElementName=ArenaStrategyStatusText}" TextWrapping="Wrap"/>
                                <Border x:Name="ArenaInspectorPanel" Margin="0,12,0,0" Visibility="Collapsed" Background="#0A0F14" BorderBrush="#273842" BorderThickness="1" CornerRadius="5" Padding="9">
                                    <StackPanel>
                                        <DockPanel Margin="0,0,0,8"><TextBlock FontFamily="Bahnschrift SemiCondensed" FontSize="15" FontWeight="SemiBold" Text="LIVE TELEMETRY"/><TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" Foreground="#96A6AA" FontSize="10" Text="Read-only"/></DockPanel>
                                        <TextBlock x:Name="BattleSummaryText" Margin="0,0,0,8" FontSize="13" FontWeight="SemiBold" Text="No active battle" TextWrapping="Wrap"/>
                                        <DataGrid x:Name="BattleGrid" Height="220" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" GridLinesVisibility="Horizontal" Background="#172129" Foreground="#F0EBDD" RowBackground="#172129" AlternatingRowBackground="#172129" BorderBrush="#273842" EnableRowVirtualization="True">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Team" Binding="{Binding Team}" Width="65"/>
                                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="150"/>
                                                <DataGridTextColumn Header="Level" Binding="{Binding Level}" Width="55"/>
                                                <DataGridTextColumn Header="Rank" Binding="{Binding Rank}" Width="50"/>
                                                <DataGridTextColumn Header="HP" Binding="{Binding Health}" Width="120"/>
                                                <DataGridTextColumn Header="State" Binding="{Binding State}" Width="70"/>
                                                <DataGridTextColumn Header="Skills (ID: cooldown)" Binding="{Binding Skills}" Width="190"/>
                                                <DataGridTextColumn Header="Effects (ID: turns)" Binding="{Binding Effects}" Width="190"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Margin="0,10,0,5" FontWeight="SemiBold" Text="Arena events"/>
                                        <ListBox x:Name="BattleEventList" Height="150" Background="#172129" Foreground="#F0EBDD" BorderBrush="#273842"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="#172129" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock FontFamily="Bahnschrift SemiCondensed" FontSize="15" FontWeight="SemiBold" Text="BATTLE DIAGNOSTICS"/>
                                <TextBlock Margin="0,3,0,10" Foreground="#96A6AA" FontSize="11" Text="Disarms automation and records battle state plus internal HUD transitions for a manual reference." TextWrapping="Wrap"/>
                                <Button x:Name="BattleDiagnosticButton" HorizontalAlignment="Left" Padding="10,6" Content="Record manual trace" Click="ToggleBattleDiagnostics_Click" ToolTip="Record one high-frequency manual Live Arena reference, including mythical form and HUD transaction changes"/>
                                <Button x:Name="MythicalClickTraceButton" Margin="0,7,0,0" HorizontalAlignment="Left" Padding="10,6" Content="Record Mythical click path" Click="ToggleMythicalClickTrace_Click" ToolTip="Record a passive 15-second HUD path while you manually click a Mythical transformation"/>
                                <Button x:Name="BattleDiagnosticClickButton" Margin="0,7,0,0" HorizontalAlignment="Left" Padding="10,6" Content="Test RAID click path" Click="ArmDiagnosticClickPath_Click" ToolTip="Use the visible skill context click handler for the next configured skill; diagnostic only"/>
                                <TextBlock x:Name="BattleDiagnosticStatusText" Margin="0,8,0,0" Foreground="#4FB3A8" FontSize="11" Text="Session diagnostics start when RAID connects." TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#172129" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="6" Padding="12">
                            <StackPanel>
                                <TextBlock FontFamily="Bahnschrift SemiCondensed" FontSize="15" FontWeight="SemiBold" Text="LOGS AND TRACES"/>
                                <TextBlock Margin="0,3,0,10" Foreground="#96A6AA" FontSize="11" Text="Open the local diagnostic folder and review active trace state." TextWrapping="Wrap"/>
                                <Button HorizontalAlignment="Left" Padding="10,6" Content="Open logs" Click="OpenLogs_Click"/>
                                <TextBlock x:Name="DeveloperTraceStatusText" Margin="0,9,0,0" Foreground="#96A6AA" FontSize="11" Text="No active diagnostic trace." TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>

